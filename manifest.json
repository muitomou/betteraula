{
  "manifest_version": 2,
  "name": "Better Aula",
  "version": "1.0",
  "description": "Personaliza tu experiencia en Aula USM. Dark mode, temas y más.",
  "minimum_chrome_version": "88",
  "permissions": [
    "activeTab",
    "storage",
    "*://aula.usm.cl/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Configurar Better Aula",
    "default_icon": "icon48.png"
  },
  "content_scripts": [
    {
      "matches": ["*://aula.usm.cl/*"],
      "css": ["styles.css"],
      "js": ["theme_injector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://aula.usm.cl/*"],
      "js": [
        "navbar-injector.js",
        "panel-ui.js",
        "theme-engine.js",
        "hidden-courses.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "images/*",
    "logousmletrasblancas.png"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "betteraula-core@tu-dominio.com",
      "strict_min_version": "120.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}